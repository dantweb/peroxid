{
  "name": "peroxid",
  "version": "0.10.0",
  "description": "HydroXid — a client storefront built on @dantweb/oxid-fe-user: own plugins, own themes, GDPR cookie consent.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:themes && vite build && npm run build:instances && npm run build:nginx",
    "build:themes": "node scripts/build-themes.mjs",
    "build:instances": "node scripts/build-instances.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "build:nginx": "node scripts/render-nginx.mjs local && node scripts/render-nginx.mjs pay1"
  },
  "dependencies": {
    "@dantweb/oxid-fe-core": "github:dantweb/oxid-fe-core#main",
    "@dantweb/oxid-fe-user": "github:dantweb/oxid-fe-user#main",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "@dantweb/oxid-fe-core": "github:dantweb/oxid-fe-core#main"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/lato": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "latest",
    "globals": "latest",
    "happy-dom": "21.0.4",
    "knip": "latest",
    "less": "^4.9.1",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "latest",
    "vue-eslint-parser": "latest",
    "vue-tsc": "^2.2.0",
    "yaml": "^2.9.1"
  }
}
